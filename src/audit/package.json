{
  "name": "demo-bank-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "build:tests": "rm -rf .test-build && tsc -p tsconfig.test.json",
    "test:unit": "bash scripts/report-tests.sh unit reports/unit",
    "test:integration": "bash scripts/report-tests.sh integration reports/integration",
    "test:e2e": "bash scripts/report-tests.sh e2e reports/e2e",
    "test": "npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "c8": "^10.1.3",
    "typescript": "^5.9.0"
  }
}
