{
  "name": "demo-bank-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "npm run -s test:unit && npm run -s test:integration",
    "test:unit": "mkdir -p test-results && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/unit.xml \"build/test/**/*.unit.test.js\"",
    "test:integration": "mkdir -p test-results && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/integration.xml \"build/test/**/*.integration.test.js\"",
    "coverage": "tsc -p tsconfig.test.json && c8 --all --src build/src --include \"build/src/**\" --reporter=text --reporter=lcov --reporter=json-summary --reports-dir coverage sh -c \"npm run -s test:unit; u=$?; npm run -s test:integration; i=$?; exit $((u|i))\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "c8": "^10.1.3",
    "typescript": "^5.9.0"
  }
}
